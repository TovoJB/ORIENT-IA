GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
ML_MODEL_PATH=model/ml_model.joblib
# Jeu de données ML (synthétique documenté par défaut ; remplacer par data/enquete/... pour la vraie collecte)
DATASET_PATH=data/synthetique/dataset_orientia_synthetique.csv
# Corpus RAG documenté (data/sources/*.md + registre_sources.csv)
RAG_SOURCES_DIR=data/sources
# Moteur d'embeddings RAG : "gemini" (API) ou "tfidf" (repli hors-ligne)
RAG_EMBEDDING=gemini
RAG_DOCUMENTS_PATH=rag_documents.txt
DB_PATH=clinique.db
# Répertoire contenant le binaire swipl (mode "Prolog exclusif"), si hors PATH
# ex: SWIPL_BIN_DIR=/home/<user>/miniconda3/envs/swipl/bin
SWIPL_BIN_DIR=
